APP_NAME="Bridges Note"
APP_ENV=local
APP_KEY=
# En producción debe ser false: con true se muestran trazas y datos internos.
APP_DEBUG=false
APP_URL=http://127.0.0.1:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_PE

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=escalebridge
DB_USERNAME=root
DB_PASSWORD=

CACHE_STORE=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# API de MINEDU / ESCALE (comando sync:locations)
ESCALE_URL=https://escale.minedu.gob.pe/padron/rest
ESCALE_RETRIES=3
ESCALE_RETRY_DELAY_MS=500
ESCALE_TIMEOUT=30
